def kliknij_widocznie(locator):
    locator.scroll_into_view_if_needed()

    expect(locator).to_be_visible()
    expect(locator).to_be_enabled()

    locator.highlight()
    locator.click(delay=100)


def zaloguj_uzytkownika(page):
    page.goto(
        LOGIN_URL,
        wait_until="domcontentloaded",
    )

    login_input = page.locator("#user_login")
    password_input = page.locator("#user_pass")
    login_button = page.locator("#wp-submit")

    expect(login_input).to_be_visible()
    expect(password_input).to_be_visible()
    expect(login_button).to_be_visible()

    login_input.fill(LOGIN)
    password_input.fill(PASSWORD)

    kliknij_widocznie(
        login_button
    )

    expect(page).to_have_url(
        re.compile(r"wp-admin"),
        timeout=15_000,
    )


def test_walidacja_pustego_formularza_kursu():
    with sync_playwright() as p:

        browser = p.chromium.launch(
            headless=False,
            slow_mo=150,
            args=["--start-maximized"],
        )

        context = browser.new_context(
            ignore_https_errors=True,
            no_viewport=True,
        )

        page = context.new_page()

        try:
            # 1. Logowanie
            zaloguj_uzytkownika(page)

            # 2. Strona kursów
            page.goto(
                COURSES_URL,
                wait_until="domcontentloaded",
            )

            add_button = page.get_by_text(
                "Utwórz nowy kurs",
                exact=True,
            )

            expect(add_button).to_be_visible(
                timeout=15_000,
            )

            kliknij_widocznie(
                add_button
            )

            # 3. Formularz kursu
            create_button = page.get_by_text(
                "Utwórz i edytuj",
                exact=True,
            )

            expect(create_button).to_be_visible(
                timeout=10_000,
            )

            # 4. Próba utworzenia bez danych
            kliknij_widocznie(
                create_button
            )

            # 5. Walidacja nazwy
            expect(
                page.get_by_text(
                    "Pole nie może pozostać puste.",
                    exact=True,
                )
            ).to_be_visible(
                timeout=10_000,
            )

            # 6. Walidacja ceny
            expect(
                page.get_by_text(
                    "Podana wartość nie może być pusta i mniejsza niż 0.",
                    exact=True,
                )
            ).to_be_visible(
                timeout=10_000,
            )

            # 7. Nie powinno przejść do edytora kursu
            expect(page).not_to_have_url(
                re.compile(
                    r"publigo-editor-course.*edit_course_id=\d+"
                )
            )

        except Exception:
            page.screenshot(
                path="walidacja_kursu_failure.png",
                full_page=True,
            )
            raise

        finally:
            context.close()
            browser.close()
