def losowy_tekst(dlugosc=8):
    return "".join(
        random.choices(
            string.ascii_uppercase + string.digits,
            k=dlugosc
        )
    )


def pole_w_wierszu(page, nazwa, selector):
    label = page.get_by_text(
        nazwa,
        exact=True
    ).first

    expect(label).to_be_visible()

    return (
        label
        .locator("xpath=ancestor::tr[1]")
        .locator(selector)
        .first
    )


def kliknij_widocznie(
    page,
    locator,
    pauza=150,
    centrum=False
):
    expect(locator).to_be_visible()
    expect(locator).to_be_enabled()

    if centrum:
        locator.evaluate(
            """
            element => element.scrollIntoView({
                behavior: 'smooth',
                block: 'center',
                inline: 'center'
            })
            """
        )
    else:
        locator.scroll_into_view_if_needed()

    locator.highlight()
    locator.hover()

    page.wait_for_timeout(pauza)

    locator.click(
        delay=120
    )


