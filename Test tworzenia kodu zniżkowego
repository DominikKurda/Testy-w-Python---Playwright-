def wypelnij_formularz_kodu(
    page,
    nazwa_promocji,
    kod,
    data_poczatkowa,
    data_wygasniecia
):
    # =========================
    # NAZWA PROMOCJI
    # =========================
    name_input = pole_w_wierszu(
        page,
        "Nazwa promocji",
        "input"
    )

    wypelnij_pole(
        page,
        name_input,
        nazwa_promocji
    )

    expect(
        name_input
    ).to_have_value(
        nazwa_promocji
    )

    # =========================
    # KOD
    # =========================
    code_input = pole_w_wierszu(
        page,
        "Kod",
        "input"
    )

    wypelnij_pole(
        page,
        code_input,
        kod
    )

    expect(
        code_input
    ).to_have_value(
        kod
    )

    # =========================
    # TYP
    # =========================
    type_select = pole_w_wierszu(
        page,
        "Typ",
        "select"
    )

    expect(
        type_select
    ).to_be_visible()

    type_select.scroll_into_view_if_needed()
    type_select.highlight()

    options = type_select.locator(
        "option"
    )

    znaleziono_typ = False

    for i in range(
        options.count()
    ):
        option = options.nth(i)

        if (
            "procent"
            in option.inner_text().lower()
        ):
            type_select.select_option(
                value=option.get_attribute(
                    "value"
                )
            )

            znaleziono_typ = True
            break

    assert znaleziono_typ, (
        "Nie znaleziono typu procentowego"
    )

    # =========================
    # WARTOŚĆ
    # =========================
    value_input = pole_w_wierszu(
        page,
        "Wartość",
        "input"
    )

    wypelnij_pole(
        page,
        value_input,
        "10"
    )

    expect(
        value_input
    ).to_have_value(
        "10"
    )

    # =========================
    # PRODUKT WYMAGANY
    # =========================
    produkt_wymagany = wybierz_produkt(
        page,
        "Produkty wymagane",
        wymagany=True
    )

    # =========================
    # PRODUKT WYKLUCZONY
    # =========================
    wybierz_produkt(
        page,
        "Produkty wykluczone",
        pomin_wartosc=produkt_wymagany,
        wymagany=False
    )

    # =========================
    # DATA POCZĄTKOWA
    # =========================
    start_date = pole_w_wierszu(
        page,
        "Data początkowa",
        "input"
    )

    wypelnij_date(
        page,
        start_date,
        data_poczatkowa
    )

    # =========================
    # DATA WYGAŚNIĘCIA
    # =========================
    expiration_date = pole_w_wierszu(
        page,
        "Wygasa",
        "input"
    )

    wypelnij_date(
        page,
        expiration_date,
        data_wygasniecia
    )

    # =========================
    # MINIMALNA KWOTA
    # =========================
    minimum_amount = pole_w_wierszu(
        page,
        "Minimalna kwota",
        "input"
    )

    wypelnij_pole(
        page,
        minimum_amount,
        "100"
    )

    expect(
        minimum_amount
    ).to_have_value(
        "100"
    )

    # =========================
    # MAKSYMALNA ILOŚĆ UŻYĆ
    # =========================
    usage_limit = pole_w_wierszu(
        page,
        "Maksymalna ilość użyć",
        "input"
    )

    wypelnij_pole(
        page,
        usage_limit,
        "5"
    )

    expect(
        usage_limit
    ).to_have_value(
        "5"
    )

    # =========================
    # JEDNORAZOWY DLA KLIENTA
    # =========================
    single_use = pole_w_wierszu(
        page,
        "Jednorazowy dla danego klienta",
        "input[type='checkbox']"
    )

    single_use.scroll_into_view_if_needed()
    single_use.highlight()

    if not single_use.is_checked():
        kliknij_widocznie(
            page,
            single_use,
            pauza=200
        )

    expect(
        single_use
    ).to_be_checked()


