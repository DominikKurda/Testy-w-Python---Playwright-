def wybierz_produkt(
    page,
    nazwa_pola,
    pomin_wartosc=None,
    wymagany=True
):
    label = page.get_by_text(
        nazwa_pola,
        exact=True
    ).first

    expect(label).to_be_visible()

    label.scroll_into_view_if_needed()
    label.highlight()

    select = (
        label
        .locator("xpath=ancestor::tr[1]")
        .locator("select")
        .first
    )

    expect(
        select
    ).to_be_attached()

    produkty = select.locator(
        "option"
    ).evaluate_all(
        """
        options => options
            .map(option => ({
                value: option.value,
                text: option.textContent
                    .replace(/\\u00a0/g, ' ')
                    .replace(/\\s+/g, ' ')
                    .trim(),
                disabled: option.disabled
            }))
            .filter(option =>
                option.value &&
                option.text &&
                !option.disabled
            )
        """
    )

    if pomin_wartosc:
        produkty = [
            produkt
            for produkt in produkty
            if produkt["value"] != pomin_wartosc
        ]

    if not produkty:
        if wymagany:
            raise AssertionError(
                f"Brak produktów w polu: "
                f"{nazwa_pola}"
            )

        return None

    produkt = produkty[0]

    select.select_option(
        value=produkt["value"],
        force=True
    )

    return produkt["value"]


