def test_tworzenie_kodu_znizkowego():
    with sync_playwright() as p:
        browser = p.chromium.launch(
            headless=False,
            slow_mo=120,
            args=[
                "--start-maximized"
            ]
        )

        context = browser.new_context(
            ignore_https_errors=True,
            no_viewport=True
        )

        page = context.new_page()

        page.set_default_timeout(
            10_000
        )

        nazwa_promocji = (
            f"Promocja_{losowy_tekst()}"
        )

        kod = (
            f"KOD_{losowy_tekst()}"
        )

        data_poczatkowa = (
            date.today()
            + timedelta(days=1)
        ).isoformat()

        data_wygasniecia = (
            date.today()
            + timedelta(days=30)
        ).isoformat()

        try:
            zaloguj_uzytkownika(
                page
            )

            otworz_kody_znizkowe(
                page
            )

            otworz_formularz_kodu(
                page
            )

            wypelnij_formularz_kodu(
                page,
                nazwa_promocji,
                kod,
                data_poczatkowa,
                data_wygasniecia
            )

            zapisz_kod(
                page
            )

            sprawdz_utworzony_kod(
                page,
                nazwa_promocji,
                kod
            )

        except Exception:
            page.screenshot(
                path="publigo_test_failure.png",
                full_page=True
            )

            raise

        finally:
            context.close()
            browser.close()
