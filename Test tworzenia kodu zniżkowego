from playwright.sync_api import sync_playwright, expect
import re
import random
import string


def losowy_tekst(dlugosc=8):
    return ''.join(random.choices(string.ascii_uppercase + string.digits, k=dlugosc))


def test_tworzenie_kodu_znizkowego():
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=False, slow_mo=300)
        page = browser.new_page()
        page.set_viewport_size({"width": 1920, "height": 1080})

        BASE_URL = "https://ndsbnhq893.go6.publigo.onl"

        nazwa_promocji = "Promocja_" + losowy_tekst()
        kod = "KOD_" + losowy_tekst()

        # LOGOWANIE
        page.goto(f"{BASE_URL}/wp-login.php")
        page.fill("#user_login", "dominikkurda6@gmail.com")
        page.fill("#user_pass", "domino2024D")

        with page.expect_navigation():
            page.click("#wp-submit")

        expect(page).to_have_url(re.compile("wp-admin|panel|dashboard"))
        print("✅ Logowanie OK")

        # STRONA KODÓW ZNIŻKOWYCH
        page.goto(f"{BASE_URL}/wp-admin/admin.php?page=wp-idea-discounts")
        expect(page.locator("h1")).to_be_visible()
        print("✅ Strona kodów zniżkowych otwarta")

        # KLIKNIJ "DODAJ KOD ZNIŻKOWY"
        dodaj_kod = page.get_by_text("Dodaj kod zniżkowy", exact=True)
        expect(dodaj_kod).to_be_visible()
        dodaj_kod.click()

        print("✅ Kliknięto Dodaj kod zniżkowy")

        # NAZWA PROMOCJI
        name_input = page.locator("input").nth(0)
        expect(name_input).to_be_visible()
        name_input.fill(nazwa_promocji)

        # KOD ZNIŻKOWY
        code_input = page.locator("input").nth(1)
        expect(code_input).to_be_visible()
        code_input.fill(kod)

        # WARTOŚĆ ZNIŻKI
        value_input = page.locator("input").nth(2)
        expect(value_input).to_be_visible()
        value_input.fill("10")

        # ZAPISZ / UTWÓRZ
        save_button = page.locator(
            "button:has-text('Zapisz'), "
            "button:has-text('Utwórz'), "
            "button:has-text('Dodaj'), "
            "input[type='submit'], "
            ".button-primary"
        ).first

        expect(save_button).to_be_visible()
        save_button.click()

        page.wait_for_timeout(3000)

        # WALIDACJA
        expect(page.locator("body")).to_contain_text(
            re.compile(nazwa_promocji + "|" + kod, re.I)
        )

        print(f"✅ Kod zniżkowy utworzony poprawnie: {nazwa_promocji} / {kod}")

        browser.close()
