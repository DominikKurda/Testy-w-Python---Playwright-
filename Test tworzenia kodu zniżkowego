def wypelnij_formularz(
    page,
    nazwa_promocji,
    kod,
    data_poczatkowa,
    data_wygasniecia,
):
    pole_w_wierszu(
        page,
        "Nazwa promocji",
        "input",
    ).fill(nazwa_promocji)

    pole_w_wierszu(
        page,
        "Kod",
        "input",
    ).fill(kod)

    type_select = pole_w_wierszu(
        page,
        "Typ",
        "select",
    )

    percentage_option = type_select.locator(
        "option"
    ).filter(
        has_text=re.compile(
            "procent",
            re.IGNORECASE,
        )
    ).first

    percentage_value = percentage_option.get_attribute(
        "value"
    )

    assert percentage_value, (
        "Nie znaleziono typu procentowego"
    )

    type_select.select_option(
        value=percentage_value
    )

    pole_w_wierszu(
        page,
        "Wartość",
        "input",
    ).fill("10")

    produkt_wymagany = wybierz_produkt(
        page,
        "Produkty wymagane",
    )

    wybierz_produkt(
        page,
        "Produkty wykluczone",
        pomin_wartosc=produkt_wymagany,
        wymagany=False,
    )

    wypelnij_date(
        page,
        pole_w_wierszu(
            page,
            "Data początkowa",
            "input",
        ),
        data_poczatkowa,
    )

    wypelnij_date(
        page,
        pole_w_wierszu(
            page,
            "Wygasa",
            "input",
        ),
        data_wygasniecia,
    )

    pole_w_wierszu(
        page,
        "Minimalna kwota",
        "input",
    ).fill("100")

    pole_w_wierszu(
        page,
        "Maksymalna ilość użyć",
        "input",
    ).fill("5")

    checkbox = pole_w_wierszu(
        page,
        "Jednorazowy dla danego klienta",
        "input[type='checkbox']",
    )

    if not checkbox.is_checked():
        kliknij_widocznie(checkbox)

    expect(checkbox).to_be_checked()


def zapisz_kod(page):
    zamknij_kalendarz(page)

    formularz = page.locator(
        "form"
    ).filter(
        has=page.get_by_text(
            "Nazwa promocji",
            exact=True,
        )
    ).first

    save_button = formularz.locator(
        "button"
    ).filter(
        has_text=re.compile(
            r"Zapisz|Utwórz|Dodaj",
            re.IGNORECASE,
        )
    )

    if save_button.count() == 0:
        save_button = formularz.locator(
            "input[type='submit'][value*='Zapisz'], "
            "input[type='submit'][value*='Utwórz'], "
            "input[type='submit'][value*='Dodaj']"
        )

    kliknij_widocznie(
        save_button.first
    )


def test_tworzenie_kodu_znizkowego():
    with sync_playwright() as p:
        browser = p.chromium.launch(
            headless=False,
            args=["--start-maximized"],
        )

        context = browser.new_context(
            ignore_https_errors=True,
            no_viewport=True,
        )

        page = context.new_page()

        nazwa_promocji = (
            f"Promocja_{uuid4().hex[:8].upper()}"
        )

        kod = (
            f"KOD_{uuid4().hex[:8].upper()}"
        )

        dzisiaj = date.today()

        try:
            zaloguj_uzytkownika(page)

            otworz_kody_znizkowe(page)

            otworz_formularz_kodu(page)

            wypelnij_formularz(
                page,
                nazwa_promocji,
                kod,
                (dzisiaj + timedelta(days=1)).isoformat(),
                (dzisiaj + timedelta(days=30)).isoformat(),
            )

            zapisz_kod(page)

            row = page.get_by_role(
                "row"
            ).filter(
                has_text=nazwa_promocji
            )

            expect(row).to_be_visible(
                timeout=15_000
            )

            expect(row).to_contain_text(
                kod
            )

        except Exception:
            page.screenshot(
                path="publigo_test_failure.png",
                full_page=True,
            )
            raise

        finally:
            browser.close()
