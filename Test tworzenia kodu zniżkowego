def pole_w_wierszu(page, nazwa, selector):
    return (
        page.get_by_text(nazwa, exact=True)
        .first
        .locator("xpath=ancestor::tr[1]")
        .locator(selector)
        .first
    )


def kliknij_widocznie(locator):
    locator.highlight()
    locator.click(delay=100)


def zamknij_kalendarz(page):
    datepicker = page.locator("#ui-datepicker-div")

    if datepicker.count() and datepicker.is_visible():
        page.keyboard.press("Escape")

    if datepicker.count() and datepicker.is_visible():
        datepicker.evaluate(
            "element => element.style.display = 'none'"
        )


def wypelnij_date(page, field, value):
    zamknij_kalendarz(page)

    field.fill(
        value,
        force=True,
    )

    field.dispatch_event("change")

    expect(field).to_have_value(value)

    zamknij_kalendarz(page)


def wybierz_produkt(
    page,
    nazwa_pola,
    pomin_wartosc=None,
    wymagany=True,
):
    label = page.get_by_text(
        nazwa_pola,
        exact=True,
    ).first

    select = (
        label
        .locator("xpath=ancestor::tr[1]")
        .locator("select")
        .first
    )

    produkty = select.locator("option").evaluate_all(
        """
        options => options
            .map(option => ({
                value: option.value,
                text: option.textContent
                    .replace(/\\u00a0/g, ' ')
                    .replace(/\\s+/g, ' ')
                    .trim(),
                disabled: option.disabled
            }))
            .filter(option =>
                option.value &&
                option.text &&
                !option.disabled
            )
        """
    )

    if pomin_wartosc:
        produkty = [
            produkt
            for produkt in produkty
            if produkt["value"] != pomin_wartosc
        ]

    if not produkty:
        if wymagany:
            raise AssertionError(
                f"Brak produktów w polu: {nazwa_pola}"
            )
        return None

    produkt = produkty[0]

    select_id = select.get_attribute("id")

    assert select_id, (
        f"Pole '{nazwa_pola}' nie posiada ID."
    )

    chosen = page.locator(
        f"#{select_id}_chosen"
    )

    kliknij_widocznie(
        chosen.locator("input").first
    )

    wynik = (
        chosen
        .locator(".chosen-results li.active-result")
        .filter(has_text=produkt["text"])
        .first
    )

    kliknij_widocznie(wynik)

    zaznaczone = select.locator(
        "option:checked"
    ).evaluate_all(
        "options => options.map(option => option.value)"
    )

    assert produkt["value"] in zaznaczone

    return produkt["value"]


