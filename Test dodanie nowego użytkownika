# ============================================================
# HELPERY
# ============================================================

def kliknij_widocznie(locator):
    locator.scroll_into_view_if_needed()

    expect(locator).to_be_visible()
    expect(locator).to_be_enabled()

    locator.highlight()
    locator.click(delay=100)


def pole_w_wierszu(page, nazwa, selector):
    return (
        page.get_by_text(nazwa, exact=True)
        .first
        .locator("xpath=ancestor::tr[1]")
        .locator(selector)
        .first
    )


# ============================================================
# LOGOWANIE
# ============================================================

def zaloguj_uzytkownika(page):
    page.goto(
        LOGIN_URL,
        wait_until="domcontentloaded",
    )

    login = page.locator("#user_login")
    password = page.locator("#user_pass")
    button = page.locator("#wp-submit")

    expect(login).to_be_visible(timeout=15_000)
    expect(password).to_be_visible(timeout=15_000)
    expect(button).to_be_visible(timeout=15_000)

    login.fill(LOGIN)
    password.fill(PASSWORD)

    kliknij_widocznie(button)

    expect(page).to_have_url(
        re.compile(r"wp-admin"),
        timeout=15_000,
    )


# ============================================================
# FORMULARZ NOWEGO UŻYTKOWNIKA
# ============================================================

def otworz_formularz_nowego_uzytkownika(page):
    page.goto(
        USER_NEW_URL,
        wait_until="domcontentloaded",
    )

    expect(page).to_have_url(
        re.compile(r"user-new\.php"),
        timeout=15_000,
    )

    expect(
        page.locator("#user_login")
    ).to_be_visible(
        timeout=15_000,
    )


# ============================================================
# HASŁO
# ============================================================

def ustaw_haslo(page, haslo):
    generuj_haslo = page.get_by_text(
        re.compile(r"Generuj hasło")
    ).first

    if (
        generuj_haslo.count()
        and generuj_haslo.is_visible()
    ):
        kliknij_widocznie(
            generuj_haslo
        )

    haslo_input = page.locator(
        "#pass1, input[name='pass1']"
    ).first

    expect(
        haslo_input
    ).to_be_visible(
        timeout=10_000,
    )

    haslo_input.fill(haslo)

    expect(
        haslo_input
    ).to_have_value(haslo)


# ============================================================
# WYPEŁNIENIE FORMULARZA
# ============================================================

def wypelnij_formularz_uzytkownika(
    page,
    username,
    email,
    imie,
    nazwisko,
    witryna,
    telefon,
    haslo,
):
    # Nazwa użytkownika
    username_input = page.locator("#user_login")

    username_input.fill(username)

    expect(
        username_input
    ).to_have_value(username)

    # Adres email
    email_input = page.locator("#email")

    email_input.fill(email)

    expect(
        email_input
    ).to_have_value(email)

    # Imię
    imie_input = page.locator("#first_name")

    imie_input.fill(imie)

    expect(
        imie_input
    ).to_have_value(imie)

    # Nazwisko
    nazwisko_input = page.locator("#last_name")

    nazwisko_input.fill(nazwisko)

    expect(
        nazwisko_input
    ).to_have_value(nazwisko)

    # Witryna internetowa
    witryna_input = page.locator("#url")

    witryna_input.fill(witryna)

    expect(
        witryna_input
    ).to_have_value(witryna)

    # Język
    jezyk = page.locator("#locale")

    if jezyk.count():
        jezyk.select_option(
            label="Domyślne w witrynie"
        )

    # Hasło
    ustaw_haslo(
        page,
        haslo,
    )

    # Wyślij powiadomienie użytkownikowi
    powiadomienie = page.locator(
        "#send_user_notification"
    )

    if (
        powiadomienie.count()
        and powiadomienie.is_checked()
    ):
        powiadomienie.uncheck()

    # Numer telefonu
    telefon_input = pole_w_wierszu(
        page,
        "Numer telefonu",
        "input",
    )

    expect(
        telefon_input
    ).to_be_visible()

    telefon_input.fill(telefon)

    expect(
        telefon_input
    ).to_have_value(telefon)


# ============================================================
# DODANIE UŻYTKOWNIKA
# ============================================================

def dodaj_uzytkownika(page):
    button = page.locator(
        "#createusersub"
    )

    if button.count() == 0:
        button = page.get_by_role(
            "button",
            name="Dodaj użytkownika",
        )

    expect(
        button
    ).to_be_visible(
        timeout=10_000,
    )

    kliknij_widocznie(button)

    page.wait_for_load_state(
        "domcontentloaded"
    )


# ============================================================
# SPRAWDZENIE NA LIŚCIE
# ============================================================

def sprawdz_uzytkownika_na_liscie(
    page,
    username,
    email,
):
    page.goto(
        USERS_URL,
        wait_until="domcontentloaded",
    )

    row = (
        page.get_by_role("row")
        .filter(has_text=email)
        .first
    )

    expect(
        row
    ).to_be_visible(
        timeout=15_000,
    )

    expect(
        row
    ).to_contain_text(username)

    expect(
        row
    ).to_contain_text(email)


