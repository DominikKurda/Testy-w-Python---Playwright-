def test_uzytkownik_moze_utworzyc_nowego_uzytkownika():
    with sync_playwright() as p:

        browser = p.chromium.launch(
            headless=False,
            slow_mo=200,
            args=["--start-maximized"],
        )

        context = browser.new_context(
            ignore_https_errors=True,
            no_viewport=True,
        )

        page = context.new_page()

        unique = uuid4().hex[:8].lower()

        username = f"jan_test_{unique}"
        email = f"jan.{unique}@example.com"

        imie = "Jan"
        nazwisko = "Kowalski"
        witryna = "https://example.com"
        telefon = "500600700"

        haslo = "Test@Publigo2026!Aa"

        try:
            # 1. Logowanie
            zaloguj_uzytkownika(page)

            # 2. Dodaj użytkownika
            otworz_formularz_nowego_uzytkownika(
                page
            )

            # 3. Wypełnienie danych
            wypelnij_formularz_uzytkownika(
                page,
                username=username,
                email=email,
                imie=imie,
                nazwisko=nazwisko,
                witryna=witryna,
                telefon=telefon,
                haslo=haslo,
            )

            # 4. Klik „Dodaj użytkownika”
            dodaj_uzytkownika(
                page
            )

            # 5. Sprawdzenie, czy użytkownik istnieje
            sprawdz_uzytkownika_na_liscie(
                page,
                username=username,
                email=email,
            )

        except Exception:
            page.screenshot(
                path="tworzenie_uzytkownika_failure.png",
                full_page=True,
            )
            raise

        finally:
            context.close()
            browser.close()
