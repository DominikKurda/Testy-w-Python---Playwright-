from playwright.sync_api import sync_playwright, expect
import re

def test_logowanie_publigo():
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=False, slow_mo=300)
        page = browser.new_page()

        # 1. Wejście na stronę
        page.goto("https://ndsbnhq893.go6.publigo.onl/wp-login.php")

        # 2. Czekaj aż formularz się załaduje
        page.wait_for_selector("#user_login")

        # 3. Wpisywanie danych
        page.fill("#user_login", "dominikkurda6@gmail.com")
        page.fill("#user_pass", "domino2024D")

        # 4. Klik – NAJPEWNIEJSZY selektor w WordPress
        login_button = page.locator("#wp-submit")

        expect(login_button).to_be_visible()
        expect(login_button).to_be_enabled()

        # Klik + czekanie na nawigację
        with page.expect_navigation():
            login_button.click()

        # 5. Sprawdzenie logowania (bez lambda!)
        expect(page).to_have_url(re.compile("wp-admin|panel|dashboard"))

        print("✅ Logowanie OK")

        browser.close()
