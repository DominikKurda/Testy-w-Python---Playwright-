# ============================================================
# HELPERY
# ============================================================

def kliknij_widocznie(locator):
    locator.scroll_into_view_if_needed()

    expect(locator).to_be_visible()
    expect(locator).to_be_enabled()

    locator.highlight()
    locator.click(delay=100)


def pole_w_wierszu(page, nazwa, selector):
    return (
        page.get_by_text(nazwa, exact=True)
        .first
        .locator("xpath=ancestor::tr[1]")
        .locator(selector)
        .first
    )


# ============================================================
# LOGOWANIE ADMINISTRATORA
# ============================================================

def zaloguj_administratora(page):
    page.goto(
        LOGIN_URL,
        wait_until="domcontentloaded",
    )

    login = page.locator("#user_login")
    password = page.locator("#user_pass")
    button = page.locator("#wp-submit")

    expect(login).to_be_visible(timeout=15_000)
    expect(password).to_be_visible(timeout=15_000)
    expect(button).to_be_visible(timeout=15_000)

    login.fill(LOGIN)
    password.fill(PASSWORD)

    kliknij_widocznie(button)

    expect(page).to_have_url(
        re.compile(r"wp-admin"),
        timeout=15_000,
    )


