def kliknij_widocznie(locator):
    locator.scroll_into_view_if_needed()

    expect(locator).to_be_visible()
    expect(locator).to_be_enabled()

    locator.highlight()
    locator.click(delay=100)


def zaloguj_uzytkownika(page):
    page.goto(
        LOGIN_URL,
        wait_until="domcontentloaded",
    )

    login_input = page.locator("#user_login")
    password_input = page.locator("#user_pass")
    login_button = page.locator("#wp-submit")

    expect(login_input).to_be_visible()
    expect(password_input).to_be_visible()
    expect(login_button).to_be_visible()

    login_input.fill(LOGIN)
    password_input.fill(PASSWORD)

    kliknij_widocznie(
        login_button
    )

    expect(page).to_have_url(
        re.compile(r"wp-admin"),
        timeout=15_000,
    )


def otworz_produkty_cyfrowe(page):
    page.goto(
        DIGITAL_PRODUCTS_URL,
        wait_until="domcontentloaded",
    )

    add_button = page.get_by_text(
        "Utwórz nowy produkt cyfrowy",
        exact=True,
    )

    expect(
        add_button
    ).to_be_visible(
        timeout=15_000,
    )

    return add_button


def pobierz_pola_formularza_produktu(page):
    create_button = page.get_by_text(
        "Utwórz i edytuj",
        exact=True,
    )

    expect(
        create_button
    ).to_be_visible(
        timeout=10_000,
    )

    formularz = create_button.locator(
        "xpath=ancestor::*[.//input][1]"
    )

    inputs = formularz.locator(
        "input:visible"
    )

    pola = []

    for i in range(inputs.count()):
        field = inputs.nth(i)

        field_type = (
            field.get_attribute("type")
            or "text"
        ).lower()

        if field_type not in (
            "hidden",
            "submit",
            "button",
            "checkbox",
            "radio",
        ):
            pola.append(field)

    assert len(pola) >= 2, (
        "Nie znaleziono pola nazwy i ceny produktu cyfrowego."
    )

    return (
        pola[0],
        pola[1],
        create_button,
    )


def utworz_produkt_cyfrowy(
    page,
    nazwa_produktu,
    cena="300",
):
    add_button = otworz_produkty_cyfrowe(
        page
    )

    kliknij_widocznie(
        add_button
    )

    (
        name_input,
        price_input,
        create_button,
    ) = pobierz_pola_formularza_produktu(
        page
    )

    # Nazwa produktu
    name_input.fill(
        nazwa_produktu
    )

    expect(
        name_input
    ).to_have_value(
        nazwa_produktu
    )

    # Cena produktu
    price_input.fill(
        cena
    )

    expect(
        price_input
    ).to_have_value(
        cena
    )

    # Utworzenie produktu
    kliknij_widocznie(
        create_button
    )

    expect(page).to_have_url(
        re.compile(
            r"publigo.*digital.*product|"
            r"edit.*product|"
            r"product.*id=\d+",
            re.IGNORECASE,
        ),
        timeout=20_000,
    )


def test_admin_moze_utworzyc_produkt_cyfrowy():
    with sync_playwright() as p:

        browser = p.chromium.launch(
            headless=False,
            slow_mo=150,
            args=["--start-maximized"],
        )

        context = browser.new_context(
            ignore_https_errors=True,
            no_viewport=True,
        )

        page = context.new_page()

        nazwa_produktu = (
            f"Produkt_cyfrowy_"
            f"{uuid4().hex[:8].upper()}"
        )

        try:
            # 1. Logowanie
            zaloguj_uzytkownika(
                page
            )

            # 2. Utworzenie produktu cyfrowego
            utworz_produkt_cyfrowy(
                page,
                nazwa_produktu,
                cena="300",
            )

            print(
                f"Produkt cyfrowy utworzony: "
                f"{nazwa_produktu}"
            )

        except Exception:
            page.screenshot(
                path="produkt_cyfrowy_failure.png",
                full_page=True,
            )

            raise

        finally:
            context.close()
            browser.close()
