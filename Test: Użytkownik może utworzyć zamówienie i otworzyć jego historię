def test_szczegoly_utworzonego_zamowienia_zawieraja_poprawne_dane():
    with sync_playwright() as p:

        browser = p.chromium.launch(
            headless=False,
            slow_mo=150,
            args=["--start-maximized"],
        )

        context = browser.new_context(
            ignore_https_errors=True,
            no_viewport=True,
        )

        page = context.new_page()

        unique = uuid4().hex[:8].lower()

        email = (
            f"zamowienie.{unique}"
            f"@example.com"
        )

        imie = "Jan"
        nazwisko = f"Testowy_{unique[:4]}"
        kwota = "300"

        data_zamowienia = (
            date.today().isoformat()
        )

        try:
            # 1. Admin loguje się
            zaloguj_uzytkownika(page)

            # 2. Historia płatności
            # 3. Dodaj zamówienie
            otworz_formularz_zamowienia(page)

            # 4. Wybór produktu
            wybierz_produkt(page)

            # 5. E-mail
            # 6. Imię
            # 7. Nazwisko
            # 8. Kwota 300
            # 9. Data
            wypelnij_formularz_zamowienia(
                page,
                email=email,
                imie=imie,
                nazwisko=nazwisko,
                kwota=kwota,
                data_zamowienia=data_zamowienia,
            )

            # 10. Utwórz zamówienie
            utworz_zamowienie(page)

            # 11. Znajdź konkretne zamówienie
            row = znajdz_zamowienie_po_emailu(
                page,
                email,
            )

            # 12. Zobacz szczegóły zamówienia
            otworz_szczegoly_zamowienia(
                page,
                row,
            )

            # 13. Wejdź w Historię zamówienia
            # Dopiero po tym test może być PASSED
            wejdz_w_historie_zamowienia(
                page
            )

        except Exception:
            page.screenshot(
                path="historia_zamowienia_failure.png",
                full_page=True,
            )
            raise

        finally:
            context.close()
            browser.close()
