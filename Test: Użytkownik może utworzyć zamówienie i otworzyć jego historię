# ============================================================
# HISTORIA ZAMÓWIENIA
# ============================================================

def wejdz_w_historie_zamowienia(page):
    # Szukamy elementu zawierającego "Historia".
    # Nie używamy exact=True.
    historia = page.locator(
        "button:visible, "
        "a:visible, "
        "[role='tab']:visible"
    ).filter(
        has_text=re.compile(
            r"Historia",
            re.IGNORECASE,
        )
    ).first

    if historia.count() == 0:
        historia = page.get_by_text(
            re.compile(
                r"Historia",
                re.IGNORECASE,
            )
        ).first

    assert historia.count() > 0, (
        "Nie znaleziono zakładki Historia."
    )

    expect(
        historia
    ).to_be_visible(
        timeout=15_000,
    )

    kliknij_widocznie(
        historia
    )

    # ========================================================
    # KOŃCOWA WALIDACJA
    # ========================================================

    # Jeśli to zakładka, powinna być aktywna.
    role = historia.get_attribute("role")

    if role == "tab":
        aria_selected = historia.get_attribute(
            "aria-selected"
        )

        if aria_selected is not None:
            expect(
                historia
            ).to_have_attribute(
                "aria-selected",
                "true",
            )

    # Dodatkowo sprawdzamy, czy po kliknięciu
    # widoczna jest zawartość związana z historią.
    zawartosc = page.get_by_text(
        re.compile(
            r"Historia|"
            r"Utworzono|"
            r"Zamówienie|"
            r"Status",
            re.IGNORECASE,
        )
    )

    expect(
        zawartosc.first
    ).to_be_visible(
        timeout=15_000,
    )


