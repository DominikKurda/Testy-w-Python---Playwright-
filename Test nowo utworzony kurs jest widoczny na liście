BASE_URL = "https://orrcpmr842.go6.publigo.onl"

LOGIN_URL = (
    f"{BASE_URL}/wp-login.php"
    "?redirect_to=https%3A%2F%2Forrcpmr842.go6.publigo.onl%2Fwp-admin%2F"
    "&reauth=1"
