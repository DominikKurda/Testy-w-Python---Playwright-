def kliknij_widocznie(locator):
    locator.scroll_into_view_if_needed()

    expect(locator).to_be_visible()
    expect(locator).to_be_enabled()

    locator.highlight()
    locator.click(delay=100)


def pole_w_wierszu(page, nazwa, selector):
    return (
        page.get_by_text(nazwa, exact=True)
        .first
        .locator("xpath=ancestor::tr[1]")
        .locator(selector)
        .first
    )


def zamknij_kalendarz(page):
    kalendarz = page.locator("#ui-datepicker-div")

    if kalendarz.count() and kalendarz.is_visible():
        page.keyboard.press("Escape")

    if kalendarz.count() and kalendarz.is_visible():
        kalendarz.evaluate(
            "element => element.style.display = 'none'"
        )


def zaloguj_uzytkownika(page):
