def wybierz_produkt(page):
    selects = page.locator("select")

    product_select = None

    # Szukamy listy zawierającej opcję "Wybierz produkt"
    for i in range(selects.count()):
        select = selects.nth(i)

        option_texts = select.locator(
            "option"
        ).all_inner_texts()

        if any(
            text.strip().lower() == "wybierz produkt"
            for text in option_texts
        ):
            product_select = select
            break

    assert product_select is not None, (
        "Nie znaleziono listy wyboru produktu."
    )

    produkty = product_select.locator(
        "option"
    ).evaluate_all(
        """
        options => options
            .map(option => ({
                value: option.value,
                text: option.textContent
                    .replace(/\\u00a0/g, ' ')
                    .replace(/\\s+/g, ' ')
                    .trim(),
                disabled: option.disabled
            }))
            .filter(option =>
                option.value &&
                option.text &&
                !option.disabled &&
                option.text.toLowerCase() !== 'wybierz produkt'
            )
        """
    )

    assert produkty, (
        "Brak dostępnych produktów."
    )

    produkt = produkty[0]

    print(
        f"Produkt do wybrania: "
        f"{produkt['text']}"
    )

    select_id = product_select.get_attribute("id")

    # Obsługa Chosen
    if select_id:
        chosen = page.locator(
            f"#{select_id}_chosen"
        )

        if (
            chosen.count()
            and chosen.is_visible()
        ):
            trigger = chosen.locator(
                ".chosen-single"
            ).first

            if trigger.count() == 0:
                trigger = chosen.locator(
                    ".chosen-choices"
                ).first

            kliknij_widocznie(
                trigger
            )

            wynik = (
                chosen
                .locator(
                    ".chosen-results li.active-result"
                )
                .filter(
                    has_text=produkt["text"]
                )
                .first
            )

            expect(
                wynik
            ).to_be_visible(
                timeout=10_000,
            )

            kliknij_widocznie(
                wynik
            )

        else:
            product_select.select_option(
                value=produkt["value"]
            )

    else:
        product_select.select_option(
            value=produkt["value"]
        )

    # Sprawdzenie wartości selecta
    expect(
        product_select
    ).to_have_value(
        produkt["value"]
    )

    selected_text = (
        product_select
        .locator("option:checked")
        .inner_text()
        .strip()
    )

    assert selected_text.lower() != "wybierz produkt"

    print(
        f"Wybrany produkt: "
        f"{selected_text}"
    )

    return selected_text


def wypelnij_formularz_zamowienia(
    page,
    email,
    imie,
    nazwisko,
    kwota,
):
    # E-mail
    email_input = pole_w_wierszu(
        page,
        "ID lub e-mail kupującego",
        "input",
    )

    email_input.fill(email)

    expect(
        email_input
    ).to_have_value(email)

    # Imię
    imie_input = pole_w_wierszu(
        page,
        "Imię kupującego",
        "input",
    )

    imie_input.fill(imie)

    expect(
        imie_input
    ).to_have_value(imie)

    # Nazwisko
    nazwisko_input = pole_w_wierszu(
        page,
        "Nazwisko kupującego",
        "input",
    )

    nazwisko_input.fill(nazwisko)

    expect(
        nazwisko_input
    ).to_have_value(nazwisko)

    # Kwota
    kwota_input = pole_w_wierszu(
        page,
        "Kwota",
        "input",
    )

    kwota_input.fill(kwota)

    expect(
        kwota_input
    ).to_have_value(kwota)

    # Wyślij potwierdzenie
    potwierdzenie = pole_w_wierszu(
        page,
        "Wyślij potwierdzenie",
        "input[type='checkbox']",
    )

    if not potwierdzenie.is_checked():
        kliknij_widocznie(
            potwierdzenie
        )

    expect(
        potwierdzenie
    ).to_be_checked()

    # Data
    data_input = pole_w_wierszu(
        page,
        "Data",
        "input",
    )

    dzisiaj = date.today().isoformat()

    data_input.fill(
        dzisiaj,
        force=True,
    )

    data_input.dispatch_event(
        "change"
    )

    expect(
        data_input
    ).to_have_value(
        dzisiaj
    )


def utworz_zamowienie(page):
    button = page.get_by_text(
        "Utwórz zamówienie",
        exact=True,
    )

    expect(
        button
    ).to_be_visible(
        timeout=10_000,
    )

    kliknij_widocznie(
        button
    )


def test_admin_moze_utworzyc_zamowienie():
    with sync_playwright() as p:

        browser = p.chromium.launch(
            headless=False,
            slow_mo=150,
            args=["--start-maximized"],
        )

        context = browser.new_context(
            ignore_https_errors=True,
            no_viewport=True,
        )

        page = context.new_page()

        unique = uuid4().hex[:8].lower()

        email = (
            f"zamowienie.{unique}"
            f"@example.com"
        )

        imie = "Jan"
        nazwisko = f"Testowy_{unique[:4]}"

        try:
            # 1. Logowanie
            zaloguj_uzytkownika(page)

            # 2. Formularz zamówienia
            otworz_formularz_zamowienia(page)

            # 3. Wybór produktu
            produkt = wybierz_produkt(page)

            # 4. Wypełnienie formularza
            wypelnij_formularz_zamowienia(
                page,
                email=email,
                imie=imie,
                nazwisko=nazwisko,
                kwota="300",
            )

            # 5. Utworzenie zamówienia
            utworz_zamowienie(page)

            # 6. Formularz powinien zostać opuszczony
            expect(page).not_to_have_url(
                re.compile(
                    r"page=publigo-manual-order"
                ),
                timeout=15_000,
            )

            print(
                "Zamówienie utworzone poprawnie."
            )

            print(
                f"Produkt: {produkt}"
            )

            print(
                f"Klient: {email}"
            )

        except Exception:
            page.screenshot(
                path="tworzenie_zamowienia_failure.png",
                full_page=True,
            )
            raise

        finally:
            context.close()
            browser.close()
