# ============================================================
# WYBÓR PRODUKTU
# ============================================================

def wybierz_produkt(
    page,
    pomin_wartosc=None,
):
    selects = page.locator("select")

    product_select = None

    for i in range(selects.count()):
        select = selects.nth(i)

        opcje = select.locator(
            "option"
        ).all_inner_texts()

        if any(
            tekst.strip().lower() == "wybierz produkt"
            for tekst in opcje
        ):
            product_select = select
            break

    assert product_select is not None, (
        "Nie znaleziono listy produktów."
    )

    produkty = product_select.locator(
        "option"
    ).evaluate_all(
        """
        options => options
            .map(option => ({
                value: option.value,
                text: option.textContent
                    .replace(/\\u00a0/g, ' ')
                    .replace(/\\s+/g, ' ')
                    .trim(),
                disabled: option.disabled
            }))
            .filter(option =>
                option.value &&
                option.text &&
                !option.disabled &&
                option.text.toLowerCase() !== 'wybierz produkt'
            )
        """
    )

    if pomin_wartosc:
        produkty = [
            produkt
            for produkt in produkty
            if produkt["value"] != pomin_wartosc
        ]

    assert produkty, (
        "Brak drugiego dostępnego produktu."
    )

    produkt = produkty[0]

    product_select.select_option(
        value=produkt["value"]
    )

    expect(
        product_select
    ).to_have_value(
        produkt["value"]
    )

    print(
        f"Wybrany produkt: {produkt['text']}"
    )

    return produkt


# ============================================================
# DANE ZAMÓWIENIA
# ============================================================

def wypelnij_formularz_zamowienia(
    page,
    email,
    imie,
    nazwisko,
    kwota,
    data_zamowienia,
):
    # E-mail
    email_input = pole_w_wierszu(
        page,
        "ID lub e-mail kupującego",
        "input",
    )

    email_input.fill(email)

    expect(
        email_input
    ).to_have_value(email)

    # Imię
    imie_input = pole_w_wierszu(
        page,
        "Imię kupującego",
        "input",
    )

    imie_input.fill(imie)

    expect(
        imie_input
    ).to_have_value(imie)

    # Nazwisko
    nazwisko_input = pole_w_wierszu(
        page,
        "Nazwisko kupującego",
        "input",
    )

    nazwisko_input.fill(nazwisko)

    expect(
        nazwisko_input
    ).to_have_value(nazwisko)

    # Kwota
    kwota_input = pole_w_wierszu(
        page,
        "Kwota",
        "input",
    )

    kwota_input.fill(kwota)

    expect(
        kwota_input
    ).to_have_value(kwota)

    # Data
    data_input = pole_w_wierszu(
        page,
        "Data",
        "input",
    )

    zamknij_kalendarz(page)

    data_input.fill(
        data_zamowienia,
        force=True,
    )

    data_input.dispatch_event(
        "change"
    )

    expect(
        data_input
    ).to_have_value(
        data_zamowienia
    )

    zamknij_kalendarz(page)


