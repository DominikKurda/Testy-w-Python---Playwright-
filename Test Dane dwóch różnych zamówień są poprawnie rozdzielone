def utworz_zamowienie(
    page,
    klient,
    pomin_produkt=None,
):
    otworz_formularz_zamowienia(page)

    produkt = wybierz_produkt(
        page,
        pomin_wartosc=pomin_produkt,
    )

    wypelnij_formularz_zamowienia(
        page,
        email=klient["email"],
        imie=klient["imie"],
        nazwisko=klient["nazwisko"],
        kwota=klient["kwota"],
        data_zamowienia=klient["data"],
    )

    button = page.get_by_text(
        "Utwórz zamówienie",
        exact=True,
    )

    expect(
        button
    ).to_be_visible(
        timeout=10_000,
    )

    kliknij_widocznie(button)

    return produkt


