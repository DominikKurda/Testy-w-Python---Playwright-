def znajdz_zamowienie(page, email):
    page.goto(
        ORDERS_URL,
        wait_until="domcontentloaded",
    )

    row = (
        page.get_by_role("row")
        .filter(
            has_text=email
        )
        .first
    )

    expect(
        row
    ).to_be_visible(
        timeout=15_000,
    )

    return row


