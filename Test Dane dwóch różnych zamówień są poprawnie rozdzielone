def test_dane_dwoch_zamowien_sa_poprawnie_rozdzielone():
    with sync_playwright() as p:

        browser = p.chromium.launch(
            headless=False,
            slow_mo=150,
            args=["--start-maximized"],
        )

        context = browser.new_context(
            ignore_https_errors=True,
            no_viewport=True,
        )

        page = context.new_page()

        unique_1 = uuid4().hex[:8].lower()
        unique_2 = uuid4().hex[:8].lower()

        # ====================================================
        # ZAMÓWIENIE 1
        # ====================================================

        klient_1 = {
            "email": f"jan.{unique_1}@example.com",
            "imie": "Jan",
            "nazwisko": "Kowalski",
            "kwota": "300",
            "data": "2026-08-24",
        }

        # ====================================================
        # ZAMÓWIENIE 2
        # ====================================================

        klient_2 = {
            "email": f"anna.{unique_2}@example.com",
            "imie": "Anna",
            "nazwisko": "Nowak",
            "kwota": "450",
            "data": "2026-08-25",
        }

        try:
            # =================================================
            # 1. LOGOWANIE
            # =================================================

            zaloguj_uzytkownika(page)

            # =================================================
            # 2. ZAMÓWIENIE JANA
            # =================================================

            produkt_1 = utworz_zamowienie(
                page,
                klient_1,
            )

            # =================================================
            # 3. ZAMÓWIENIE ANNY
            # inny produkt
            # =================================================

            produkt_2 = utworz_zamowienie(
                page,
                klient_2,
                pomin_produkt=produkt_1["value"],
            )

            # Produkty muszą być różne
            assert (
                produkt_1["value"]
                != produkt_2["value"]
            ), "Wybrano ten sam produkt."

            # =================================================
            # 4. ZAMÓWIENIE JANA
            # =================================================

            row_jan = znajdz_zamowienie(
                page,
                klient_1["email"],
            )

            # Dane Jana istnieją
            expect(
                row_jan
            ).to_contain_text(
                klient_1["email"]
            )

            expect(
                row_jan
            ).to_contain_text(
                klient_1["imie"]
            )

            expect(
                row_jan
            ).to_contain_text(
                klient_1["nazwisko"]
            )

            # Dane Anny NIE mogą być
            # w zamówieniu Jana
            expect(
                row_jan
            ).not_to_contain_text(
                klient_2["email"]
            )

            expect(
                row_jan
            ).not_to_contain_text(
                klient_2["imie"]
            )

            expect(
                row_jan
            ).not_to_contain_text(
                klient_2["nazwisko"]
            )

            # =================================================
            # 5. ZAMÓWIENIE ANNY
            # =================================================

            row_anna = znajdz_zamowienie(
                page,
                klient_2["email"],
            )

            # Dane Anny istnieją
            expect(
                row_anna
            ).to_contain_text(
                klient_2["email"]
            )

            expect(
                row_anna
            ).to_contain_text(
                klient_2["imie"]
            )

            expect(
                row_anna
            ).to_contain_text(
                klient_2["nazwisko"]
            )

            # Dane Jana NIE mogą być
            # w zamówieniu Anny
            expect(
                row_anna
            ).not_to_contain_text(
                klient_1["email"]
            )

            expect(
                row_anna
            ).not_to_contain_text(
                klient_1["imie"]
            )

            expect(
                row_anna
            ).not_to_contain_text(
                klient_1["nazwisko"]
            )

        except Exception:
            page.screenshot(
                path="rozdzielenie_zamowien_failure.png",
                full_page=True,
            )
            raise

        finally:
            context.close()
            browser.close()
