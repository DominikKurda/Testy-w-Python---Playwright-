import re

from playwright.sync_api import Locator, sync_playwright, expect


BASE_URL = "https://blazedemo.com"

ROUTE = {
    "from": "Paris",
    "to": "London",
}

PASSENGER = {
    "#inputName": "Jan Kowalski",
    "#address": "ul. Marszałkowska 1",
    "#city": "Warszawa",
    "#state": "Mazowieckie",
    "#zipCode": "00-001",
    "#creditCardNumber": "4111111111111111",
    'input[name="creditCardMonth"]': "12",
    'input[name="creditCardYear"]': "2028",
    "#nameOnCard": "JAN KOWALSKI",
}


def type_visible(locator: Locator, text: str) -> None:
    locator.evaluate(
        "el => el.scrollIntoView({behavior: 'smooth', block: 'center'})"
    )
    locator.highlight()
    locator.click()
    locator.press_sequentially(text, delay=30)


def click_visible(locator: Locator) -> None:
    locator.evaluate(
        "el => el.scrollIntoView({behavior: 'smooth', block: 'center'})"
    )
    locator.highlight()
    locator.hover()
    locator.click(delay=150)


def select_visible(locator: Locator, value: str) -> None:
    locator.highlight()
    locator.select_option(value)


def test_zakup_biletu():
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=False)

        try:
            page = browser.new_page(
                viewport={"width": 1920, "height": 1080}
            )

            # 1. Otwarcie strony
            page.goto(BASE_URL, wait_until="domcontentloaded")

            # 2. Wybór trasy
            departure = page.locator("select[name='fromPort']")
            destination = page.locator("select[name='toPort']")

            expect(departure).to_be_visible()
            expect(destination).to_be_visible()

            select_visible(departure, ROUTE["from"])
            select_visible(destination, ROUTE["to"])

            # 3. Wyszukanie lotów
            find_flights = page.locator("input[type='submit']")

            click_visible(find_flights)

            expect(page).to_have_url(
                re.compile(r".*/reserve\.php")
            )

            # 4. Wybór pierwszego lotu
            flights = page.locator("table tbody tr")

            expect(flights.first).to_be_visible()

            choose_flight = flights.first.locator(
                "input[type='submit']"
            )

            click_visible(choose_flight)

            expect(page).to_have_url(
                re.compile(r".*/purchase\.php")
            )

            # 5. Wypełnienie formularza
            for selector, value in PASSENGER.items():
                field = page.locator(selector)

                expect(field).to_be_visible()
                type_visible(field, value)

            # 6. Zapamiętanie danych
            remember = page.locator("#rememberMe")

            if remember.is_visible():
                remember.evaluate(
                    "el => el.scrollIntoView("
                    "{behavior: 'smooth', block: 'center'})"
                )
                remember.highlight()
                remember.check()

            # 7. Zakup biletu
            purchase_button = page.locator(
                "input[type='submit']"
            )

            click_visible(purchase_button)

            # 8. Potwierdzenie zakupu
            confirmation = page.locator("h1")

            expect(confirmation).to_have_text(
                re.compile(
                    r"Thank you for your purchase",
                    re.IGNORECASE
                )
            )

            confirmation.highlight()

            # 9. Walidacja ID transakcji
            confirmation_id = page.locator(
                "table tbody tr:nth-child(1) td:nth-child(2)"
            )

            expect(confirmation_id).to_have_text(
                re.compile(r"^\d+$")
            )

            confirmation_id.highlight()

        finally:
            browser.close()
