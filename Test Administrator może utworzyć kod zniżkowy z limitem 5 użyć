def sprawdz_utworzony_kod(
    page,
    nazwa_promocji,
    kod,
):
    row = (
        page.get_by_role("row")
        .filter(
            has_text=nazwa_promocji
        )
        .first
    )

    expect(
        row
    ).to_be_visible(
        timeout=15_000,
    )

    expect(
        row
    ).to_contain_text(
        kod
    )


