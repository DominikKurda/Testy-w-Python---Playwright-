def test_admin_moze_utworzyc_kod_znizkowy_z_limitem_5_uzyc():
    with sync_playwright() as p:

        browser = p.chromium.launch(
            headless=False,
            slow_mo=150,
            args=[
                "--start-maximized",
            ],
        )

        context = browser.new_context(
            ignore_https_errors=True,
            no_viewport=True,
        )

        page = context.new_page()

        unique = uuid4().hex[:8].upper()

        nazwa_kursu = (
            f"Kurs_LIMIT5_{unique}"
        )

        nazwa_promocji = (
            f"Promocja_LIMIT5_{unique}"
        )

        kod = (
            f"LIMIT5_{unique}"
        )

        try:
            # 1. Logowanie
            zaloguj_uzytkownika(page)

            # 2. Kurs
            utworz_kurs(
                page,
                nazwa_kursu,
                cena="300",
            )

            # 3. Kody
            otworz_kody_znizkowe(page)

            # 4. Formularz
            otworz_formularz_kodu(page)

            # 5. Dane kodu
            wypelnij_kod_limit_5(
                page,
                nazwa_promocji,
                kod,
                nazwa_kursu,
            )

            # 6. Zapis
            zapisz_kod(page)

            # 7. Asercja
            sprawdz_utworzony_kod(
                page,
                nazwa_promocji,
                kod,
            )

        except Exception:
            page.screenshot(
                path="kod_limit5_failure.png",
                full_page=True,
            )
            raise

        finally:
            context.close()
            browser.close()
