def zapisz_kod(page):
    zamknij_kalendarz(page)

    formularz = (
        page.locator("form")
        .filter(
            has=page.get_by_text(
                "Nazwa promocji",
                exact=True,
            )
        )
        .first
    )

    save_button = (
        formularz
        .locator("button")
        .filter(
            has_text=re.compile(
                r"Zapisz|Utwórz|Dodaj",
                re.IGNORECASE,
            )
        )
    )

    if save_button.count() == 0:
        save_button = formularz.locator(
            "input[type='submit'][value*='Zapisz'], "
            "input[type='submit'][value*='Utwórz'], "
            "input[type='submit'][value*='Dodaj']"
        )

    if save_button.count() == 0:
        save_button = formularz.locator(
            "input[type='submit']"
        )

    assert save_button.count() > 0, (
        "Nie znaleziono przycisku zapisu."
    )

    expect(
        save_button.first
    ).to_be_visible()

    kliknij_widocznie(
        save_button.first
    )


