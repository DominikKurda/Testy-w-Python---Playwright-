def wybierz_kurs(
    page,
    nazwa_kursu,
):
    label = page.get_by_text(
        "Produkty wymagane",
        exact=True,
    ).first

    select = (
        label
        .locator("xpath=ancestor::tr[1]")
        .locator("select")
        .first
    )

    opcje = select.locator(
        "option"
    ).evaluate_all(
        """
        options => options
            .map(option => ({
                value: option.value,
                text: option.textContent
                    .replace(/\\u00a0/g, ' ')
                    .replace(/\\s+/g, ' ')
                    .trim(),
                disabled: option.disabled
            }))
            .filter(option =>
                option.value &&
                option.text &&
                !option.disabled
            )
        """
    )

    kurs = next(
        (
            opcja
            for opcja in opcje
            if nazwa_kursu.lower()
            in opcja["text"].lower()
        ),
        None,
    )

    assert kurs, (
        f"Nie znaleziono kursu: "
        f"{nazwa_kursu}"
    )

    select_id = select.get_attribute(
        "id"
    )

    assert select_id, (
        "Pole Produkty wymagane "
        "nie posiada ID."
    )

    chosen = page.locator(
        f"#{select_id}_chosen"
    )

    kliknij_widocznie(
        chosen.locator("input").first
    )

    wynik = (
        chosen
        .locator(
            ".chosen-results li.active-result"
        )
        .filter(
            has_text=kurs["text"]
        )
        .first
    )

    expect(
        wynik
    ).to_be_visible()

    kliknij_widocznie(
        wynik
    )

    zaznaczone = select.locator(
        "option:checked"
    ).evaluate_all(
        "options => options.map(option => option.value)"
    )

    assert kurs["value"] in zaznaczone


def wypelnij_kod_limit_5(
    page,
    nazwa_promocji,
    kod,
    nazwa_kursu,
):
    pole_w_wierszu(
        page,
        "Nazwa promocji",
        "input",
    ).fill(
        nazwa_promocji
    )

    pole_w_wierszu(
        page,
        "Kod",
        "input",
    ).fill(
        kod
    )

    # ========================================================
    # TYP PROCENTOWY
    # ========================================================

    typ = pole_w_wierszu(
        page,
        "Typ",
        "select",
    )

    procent = (
        typ
        .locator("option")
        .filter(
            has_text=re.compile(
                "procent",
                re.IGNORECASE,
            )
        )
        .first
    )

    procent_value = (
        procent.get_attribute("value")
    )

    assert procent_value, (
        "Nie znaleziono "
        "rabatu procentowego."
    )

    typ.select_option(
        value=procent_value
    )

    # ========================================================
    # WARTOŚĆ
    # ========================================================

    wartosc = pole_w_wierszu(
        page,
        "Wartość",
        "input",
    )

    wartosc.fill("10")

    expect(
        wartosc
    ).to_have_value(
        "10"
    )

    # ========================================================
    # KURS
    # ========================================================

    wybierz_kurs(
        page,
        nazwa_kursu,
    )

    # ========================================================
    # DATY
    # ========================================================

    dzisiaj = date.today()

    wypelnij_date(
        page,
        pole_w_wierszu(
            page,
            "Data początkowa",
            "input",
        ),
        (
            dzisiaj
            + timedelta(days=1)
        ).isoformat(),
    )

    wypelnij_date(
        page,
        pole_w_wierszu(
            page,
            "Wygasa",
            "input",
        ),
        (
            dzisiaj
            + timedelta(days=30)
        ).isoformat(),
    )

    # ========================================================
    # MINIMALNA KWOTA
    # ========================================================

    minimum = pole_w_wierszu(
        page,
        "Minimalna kwota",
        "input",
    )

    minimum.fill(
        "100"
    )

    expect(
        minimum
    ).to_have_value(
        "100"
    )

    # ========================================================
    # LIMIT
    # ========================================================

    limit = pole_w_wierszu(
        page,
        "Maksymalna ilość użyć",
        "input",
    )

    limit.fill(
        "5"
    )

    expect(
        limit
    ).to_have_value(
        "5"
    )

    # ========================================================
    # JEDNORAZOWY DLA KLIENTA
    # ========================================================

    checkbox = pole_w_wierszu(
        page,
        "Jednorazowy dla danego klienta",
        "input[type='checkbox']",
    )

    if not checkbox.is_checked():
        kliknij_widocznie(
            checkbox
        )

    expect(
        checkbox
    ).to_be_checked()


