def utworz_kurs(
    page,
    nazwa_kursu,
    cena="300",
):
    otworz_kursy(page)

    kliknij_widocznie(
        page.get_by_text(
            "Utwórz nowy kurs",
            exact=True,
        )
    )

    button = page.get_by_text(
        "Utwórz i edytuj",
        exact=True,
    )

    expect(button).to_be_visible()

    formularz = button.locator(
        "xpath=ancestor::*[.//input][1]"
    )

    inputs = formularz.locator(
        "input:visible"
    )

    pola = []

    for i in range(inputs.count()):
        field = inputs.nth(i)

        typ = (
            field.get_attribute("type")
            or "text"
        ).lower()

        if typ not in (
            "hidden",
            "submit",
            "button",
            "checkbox",
            "radio",
        ):
            pola.append(field)

    assert len(pola) >= 2, (
        "Nie znaleziono pola nazwy i ceny."
    )

    pola[0].fill(
        nazwa_kursu
    )

    pola[1].fill(
        cena
    )

    expect(
        pola[0]
    ).to_have_value(
        nazwa_kursu
    )

    expect(
        pola[1]
    ).to_have_value(
        cena
    )

    kliknij_widocznie(
        button
    )

    expect(page).to_have_url(
        re.compile(
            r"publigo-editor-course.*"
            r"edit_course_id=\d+"
        ),
        timeout=20_000,
    )


